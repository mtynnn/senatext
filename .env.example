# Supabase (clave anónima solamente; nunca la service-role en variables VITE_*)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL del reconocedor de señas (FastAPI en Google Colab, expuesto con túnel de Cloudflare).
# OJO: esta URL cambia cada vez que se reinicia el túnel de Colab; hay que actualizarla
# y reiniciar `npm run dev`. Sin barra final. Si queda vacía, la app usa el modo simulado.
VITE_URL_RECONOCEDOR=

# Poner en true para forzar el comportamiento simulado aunque haya URL.
VITE_MODO_SIMULADO=
